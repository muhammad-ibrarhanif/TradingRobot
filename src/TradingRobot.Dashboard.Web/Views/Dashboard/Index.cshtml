@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div id="app" data-default-symbol="@Model.DefaultSymbol">
  <header class="topbar">
    <div class="symbol-picker">
      <select id="symbol-select"><option value="@Model.DefaultSymbol">@Model.DefaultSymbol</option></select>
    </div>
    <span class="exchange-label">Binance</span>

    <div class="timeframes" id="timeframes">
      @foreach (var tf in Model.Timeframes)
      {
        <button type="button" class="tf-btn" data-interval="@tf">@tf</button>
      }
    </div>

    <div class="date-range">
      <input type="date" id="from-date" title="Test against a specific historical range instead of live data" />
      <span>to</span>
      <input type="date" id="to-date" />
      <button type="button" id="load-range-btn">Load range</button>
      <button type="button" id="live-btn" class="live-btn active" title="Back to live data">● Live</button>
    </div>

    <button type="button" id="indicators-btn" class="indicators-btn" disabled title="Indicator overlays are planned for a later build pass — see Dashboard-Frontend-Requirements.md item 4.">
      Indicators (coming soon)
    </button>
  </header>

  <div class="replay-controls" id="replay-controls" style="display: none;">
    <span class="replay-label">Replay:</span>
    <button type="button" id="replay-play-btn">⏸ Pause</button>
    <select id="replay-speed" title="Candles per tick">
      <option value="400">Slow</option>
      <option value="150" selected>Normal</option>
      <option value="40">Fast</option>
    </select>
    <button type="button" id="replay-skip-btn">Skip to end</button>
    <span id="replay-progress" class="replay-progress">0/0</span>
  </div>

  <div class="chart-row">
    <div class="tools-bar" id="tools-bar">
      <button type="button" class="tool-btn active" data-tool="cursor" title="Cursor">↖</button>
      <button type="button" class="tool-btn" data-tool="trendline" title="Trendline">╱</button>
      <button type="button" class="tool-btn" data-tool="horizontal" title="Horizontal level">─</button>
      <button type="button" class="tool-btn" data-tool="eraser" title="Clear drawings">⌫</button>
    </div>

    <div class="chart-container">
      <div id="chart"></div>
      <canvas id="draw-overlay"></canvas>
    </div>
  </div>

  <div class="legend">
    <span class="legend-item legend-signal">● Signal — a running strategy fired a buy/sell</span>
    <span class="legend-item legend-pattern">● Pattern — a recognizable price-action shape, not a trade call</span>
  </div>
</div>

@section Scripts {
<script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
<script src="https://unpkg.com/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script src="~/js/dashboard.js"></script>
}
